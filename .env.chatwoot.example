# Enable the independent Chatwoot support launcher.
VITE_CHATWOOT_ENABLED=true

# Chatwoot Cloud: https://app.chatwoot.com
# Self-hosted: your Chatwoot origin, without a trailing slash.
VITE_CHATWOOT_BASE_URL=https://app.chatwoot.com

# Website inbox token from Chatwoot: Settings > Inboxes > Website > Configuration.
VITE_CHATWOOT_WEBSITE_TOKEN=

# Keep false to load the Chatwoot SDK only after the user clicks Support.
# Set true only when proactive messages or immediate unread updates are required.
VITE_CHATWOOT_PRELOAD=false

# Optional but recommended. Deploy the included Supabase Edge Function first,
# then use its public function URL here.
VITE_CHATWOOT_IDENTITY_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/chatwoot-identity

# Set CHATWOOT_HMAC_SECRET as a Supabase Edge Function secret, not a Vite variable.
