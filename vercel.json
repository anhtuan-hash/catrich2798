{
  "installCommand": "npm ci --no-audit --no-fund --registry=https://registry.npmjs.org",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/bes-fonts/brian-personal-font.ttf",
      "destination": "https://raw.githubusercontent.com/notofonts/noto-fonts/main/hinted/ttf/NotoSans/NotoSans-Regular.ttf"
    },
    {
      "source": "/api/briefing-weather",
      "destination": "/api/gateway?handler=briefing-weather"
    },
    {
      "source": "/api/check-embed",
      "destination": "/api/gateway?handler=check-embed"
    },
    {
      "source": "/api/google-drive-homeroom-backup",
      "destination": "/api/gateway?handler=google-drive-homeroom-backup"
    },
    {
      "source": "/api/weekly-practice-drive-action",
      "destination": "/api/gateway?handler=weekly-practice-drive-action"
    },
    {
      "source": "/api/weekly-practice-file",
      "destination": "/api/gateway?handler=weekly-practice-file"
    },
    {
      "source": "/api/work-hub-archive-resource",
      "destination": "/api/gateway?handler=work-hub-archive-resource"
    },
    {
      "source": "/api/work-hub-file-access",
      "destination": "/api/gateway?handler=work-hub-file-access"
    },
    {
      "source": "/api/work-hub-file-action",
      "destination": "/api/gateway?handler=work-hub-file-action"
    },
    {
      "source": "/api/work-hub-file",
      "destination": "/api/gateway?handler=work-hub-file"
    },
    {
      "source": "/api/external-app-requests",
      "destination": "/api/resource-sync?scope=external-app-requests"
    },
    {
      "source": "/api/news-article",
      "destination": "/api/news-feed?scope=article"
    },
    {
      "source": "/api/google-drive-callback",
      "destination": "/api/google-drive-connect?scope=callback"
    },
    {
      "source": "/api/google-drive-move",
      "destination": "/api/google-drive-delete?scope=move"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/main-DJcIaHTQ.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/bes-fonts/brian-personal-font.ttf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "font/ttf"
        }
      ]
    },
    {
      "source": "/hero/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hero/hero-current.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self' https: data: blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; font-src 'self' data:; frame-src 'self' https:; media-src 'self' https: blob:; worker-src 'self' blob:"
        }
      ]
    }
  ]
}
