{
  "openapi": "3.1.0",
  "info": {
    "title": "Brian Question Bank",
    "version": "1.1.0",
    "description": "Connect ChatGPT to Brian's Question Bank. Use saveBrianExam after completing a full exam, saveBrianQuestions for standalone or bundled questions, searchBrianQuestions to reuse existing items, and getBrianExam to reopen a saved exam. Preserve shared reading/cloze stimuli as bundle objects. Never request or transmit the user's Brian password."
  },
  "servers": [
    {
      "url": "https://esl-brian.vercel.app"
    }
  ],
  "security": [
    {
      "BrianQuestionBankKey": []
    }
  ],
  "paths": {
    "/api/question-bank/save-exam": {
      "post": {
        "operationId": "saveBrianExam",
        "summary": "Save a completed exam to Brian",
        "description": "Default persistence action after a complete exam has been drafted for the Brian-linked workflow. Save the full exam, answer key, explanations, metadata, optional blueprint, and any shared bundle context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "exam"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "exam": {
                    "$ref": "#/components/schemas/Exam"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exam saved. Returns the Brian test and question IDs."
          },
          "400": {
            "description": "Invalid exam payload."
          },
          "401": {
            "description": "Connection key missing, invalid, or inactive."
          },
          "429": {
            "description": "Rate limit reached."
          }
        }
      }
    },
    "/api/question-bank/save-questions": {
      "post": {
        "operationId": "saveBrianQuestions",
        "summary": "Save questions to Brian",
        "description": "Save standalone questions or a context-aware bundle such as a reading passage, cloze text, notice, dialogue, or other shared stimulus. Duplicate fingerprints are reused instead of inserted twice.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "questions"
                ],
                "properties": {
                  "requestId": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "bundle": {
                    "$ref": "#/components/schemas/Bundle"
                  },
                  "questions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "$ref": "#/components/schemas/Question"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Questions saved or matched to existing items."
          },
          "400": {
            "description": "Invalid question payload."
          },
          "401": {
            "description": "Connection key missing, invalid, or inactive."
          },
          "429": {
            "description": "Rate limit reached."
          }
        }
      }
    },
    "/api/question-bank/search-questions": {
      "post": {
        "operationId": "searchBrianQuestions",
        "summary": "Search the user's Brian Question Bank",
        "description": "Search before drafting when reuse is helpful, or when the user asks to find existing questions. Results belong to the connected Brian account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filters": {
                    "$ref": "#/components/schemas/SearchFilters"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 30
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching question-bank items."
          },
          "401": {
            "description": "Connection key missing, invalid, or inactive."
          }
        }
      }
    },
    "/api/question-bank/get-exam": {
      "post": {
        "operationId": "getBrianExam",
        "summary": "Open a saved Brian exam",
        "description": "Retrieve one exam and its ordered question items from the connected Brian account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "testId"
                ],
                "properties": {
                  "testId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved exam and ordered items."
          },
          "401": {
            "description": "Connection key missing, invalid, or inactive."
          },
          "404": {
            "description": "Exam not found in this connected account."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BrianQuestionBankKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Paste the one-time Brian Question Bank connection key generated in Brian. Brian stores only its SHA-256 hash."
      }
    },
    "schemas": {
      "Bundle": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "bundleType": {
            "type": "string",
            "description": "Examples: reading, cloze, notice, dialogue, passage."
          },
          "contextText": {
            "type": "string",
            "description": "The complete shared stimulus/passage. Do not split it across questions."
          },
          "instructions": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "unitName": {
            "type": "string"
          },
          "schoolYear": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sourceReference": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "personal",
              "department"
            ],
            "default": "private",
            "description": "Use private/personal for owner-only content; Brian normalizes both to the table-specific private value. Use department to share within the department."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "approved",
              "published",
              "closed",
              "retired",
              "archived"
            ],
            "default": "draft",
            "description": "Brian normalizes compatible status aliases to the target table's allowed values."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "Question": {
        "type": "object",
        "required": [
          "stem"
        ],
        "properties": {
          "stem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 12
          },
          "correctAnswer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "questionType": {
            "type": "string",
            "description": "Examples: mcq, cloze, reading, true_false, sentence_rewrite."
          },
          "skill": {
            "type": "string"
          },
          "cefr": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "cognitiveLevel": {
            "type": "string",
            "enum": [
              "recognition",
              "comprehension",
              "application"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "unitName": {
            "type": "string"
          },
          "schoolYear": {
            "type": "string"
          },
          "grammarPoint": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          },
          "sourceReference": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "personal",
              "department"
            ],
            "default": "private",
            "description": "Use private/personal for owner-only content; Brian normalizes both to the table-specific private value. Use department to share within the department."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "approved",
              "published",
              "closed",
              "retired",
              "archived"
            ],
            "default": "draft",
            "description": "Brian normalizes compatible status aliases to the target table's allowed values."
          },
          "bundlePosition": {
            "type": "integer",
            "minimum": 1
          },
          "points": {
            "type": "number"
          }
        },
        "additionalProperties": true
      },
      "Exam": {
        "type": "object",
        "required": [
          "title",
          "questions"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "schoolYear": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "instructions": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "personal",
              "department"
            ],
            "default": "private",
            "description": "Use private/personal for owner-only content; Brian normalizes both to the table-specific private value. Use department to share within the department."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "approved",
              "published",
              "closed",
              "retired",
              "archived"
            ],
            "default": "draft",
            "description": "Brian normalizes compatible status aliases to the target table's allowed values."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "default": "ChatGPT"
          },
          "sourceReference": {
            "type": "string"
          },
          "bundle": {
            "$ref": "#/components/schemas/Bundle"
          },
          "blueprint": {
            "type": "object",
            "additionalProperties": true
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          }
        },
        "additionalProperties": true
      },
      "SearchFilters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "cefr": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "questionType": {
            "type": "string"
          },
          "cognitiveLevel": {
            "type": "string",
            "enum": [
              "recognition",
              "comprehension",
              "application"
            ]
          },
          "topic": {
            "type": "string"
          },
          "grammarPoint": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "approved",
              "archived"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
